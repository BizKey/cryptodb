# Параметры подключения к PostgreSQL.
# Используются и клиентами (psql и т. п.), и docker compose — для инициализации сервера.
# Скопируйте в `.env` и заполните своими значениями (файл `.env` в git не коммитится).

# Образ PostgreSQL. Вариант *-alpine заметно легче — важно при 1 ГБ RAM и 10 ГБ диска.
# Можно сменить версию, например: postgres:17-alpine
POSTGRES_IMAGE=postgres:18-alpine

PGHOST=localhost
PGPORT=5432
PGDATABASE=cryptodb
PGUSER=cryptodb
# Обязательно смените на надёжный пароль (сгенерировать: openssl rand -hex 16)!
PGPASSWORD=changeme
